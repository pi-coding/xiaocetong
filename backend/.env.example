# 复制为 .env 后按需修改
APP_NAME=校厕通
DEBUG=true

# SQLite（默认）
DATABASE_URL=sqlite:///./cct.db
# MySQL 示例（切换后需安装 pymysql）
# DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/cct?charset=utf8mb4

JWT_SECRET=cct-dev-secret-change-me-please-32byte
JWT_EXPIRE_MINUTES=10080

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 二维码内容使用的前端地址（手机扫码访问）
FRONTEND_BASE_URL=http://localhost:5173

# AI 助手：留空则使用内置规则引擎（离线可演示）
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini